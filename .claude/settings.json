{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "if": "Bash(git add *)",
            "command": "$d = if ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { (Get-Location).Path }; & \"$d\\.claude\\hooks\\guard-git.ps1\"",
            "timeout": 20,
            "statusMessage": "Checking staging policy"
          },
          {
            "type": "command",
            "shell": "powershell",
            "if": "Bash(git push *)",
            "command": "$d = if ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { (Get-Location).Path }; & \"$d\\.claude\\hooks\\guard-git.ps1\"",
            "timeout": 20,
            "statusMessage": "Checking push target"
          },
          {
            "type": "command",
            "shell": "powershell",
            "if": "Bash(gh pr merge *)",
            "command": "$d = if ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { (Get-Location).Path }; & \"$d\\.claude\\hooks\\guard-git.ps1\"",
            "timeout": 20,
            "statusMessage": "Checking merge authorization"
          },
          {
            "type": "command",
            "shell": "powershell",
            "if": "Bash(git commit *)",
            "command": "$d = if ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { (Get-Location).Path }; & \"$d\\.claude\\hooks\\verify-core.ps1\"",
            "timeout": 300,
            "statusMessage": "Running core gates before commit"
          }
        ]
      }
    ]
  }
}
