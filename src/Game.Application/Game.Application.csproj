<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mirrors Game.Domain: net8.0 for tests and CI, netstandard2.1 for the Unity plugin. -->
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Game.Application</RootNamespace>
    <AssemblyName>Game.Application</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Game.Domain\Game.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Compat\*.cs" LinkBase="Compat" />
  </ItemGroup>

</Project>
